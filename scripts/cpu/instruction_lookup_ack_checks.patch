+    // Targeted I-cache sequence: prime a warm line, consume its buffered
+    // lookahead, replace the buffer with another instruction line, then
+    // revisit the still-resident first line through the ordinary C_LOOK path.
+    // Finally invalidate the I-bank, change backing memory, and require a
+    // fresh refill rather than stale buffered/tag data.
+    ce_run = 1; c_instr = 1;
+    mem[32'hF200>>2] = 32'h1020_3040;
+    mem[32'hF204>>2] = 32'h5060_7080;
