--- rtl/ap68040/rtl/ap040_core.v
+++ rtl/ap68040/rtl/ap040_core.v
@@ -2019,7 +2019,7 @@
 		                 // selected a state earlier) at dbg_a7 - 4
 		                 state == S_DECODE || state == S_BCC_EXT ||
 		                 state == S_JSR1 || state == S_PEA1 ||
-		                 state == S_LINK2 || pipe_load_launch))) &&
