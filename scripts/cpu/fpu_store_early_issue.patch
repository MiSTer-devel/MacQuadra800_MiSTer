+                            hint_st_movem || hint_st_mwr || hint_st_fpu;
 wire [31:0] hint_store_addr = hint_st_move_ea ? ea_addr :
                               hint_st_exec  ? dst_addr :
                               hint_st_mwr   ? m_addr_r :
