Sections:
00: "org0001:0" (0-20BC)


Source: "kernels/fpstore.s"
                            	     1: ; fp_store_trace 2026-10-24: back-to-back FP store kernels for the dual
                            	     2: ; core's standalone bench (rtl/ap68040_faster/tb/tb_ap68040.sv) and the
                            	     3: ; shipping core's scratch bench (tb_wombat_prog).  As the attribution's C
                            	     4: ; images: user mode, copyback data (DTT0), both caches on; the bench
                            	     5: ; registers through DTT1 (supervisor, noncachable), so a stamp is a TRAP #0
                            	     6: ; with the tag in d0.  Each kernel runs twice: the first pass warms the
                            	     7: ; caches (I-cache, and the buffer's lines allocated dirty), the second is
                            	     8: ; the one to read.  Stamp tags: kernel << 4 | pass, pass 1 first (odd
                            	     9: ; tags), then pass 0 (even tags); the closing stamp of a kernel is its
                            	    10: ; opening tag + 8, and the cycles printed with it are the kernel's.
                            	    11: ;
                            	    12: ;   $1x  empty (the stamp overhead)
                            	    13: ;   $2x  100 x fmove.d fp0,(a0)+          FPU_K_OUT8 with the (An)+ update
                            	    14: ;   $3x  100 x fmove.d fp0,(a0)           the same address every time
                            	    15: ;   $4x  100 x fmove.d fp0,(a0)+ ; addq.l #1,d1
                            	    16: ;   $5x  100 x fmove.d fp0,(a0)  ; addq.l #1,d1
                            	    17: ;   $6x  100 x fmove.s fp0,(a0)+          FPU_K_OUT4: no GET, one store
                            	    18: ;   $7x  100 x fmove.x fp0,(a0)+          FPU_K_OUT12: two GETs, three stores
                            	    19: ;   $8x   50 x fmove.x fp0,-(a7)
                            	    20: ;   $9x   50 x fmovem.x fp0-fp1,-(a7)
                            	    21: ;   $Ax   50 x fmovem.x (a7)+,fp0-fp1
                            	    22: ;   $Bx  100 x fmove.l fp0,(a0)+          integer store: F_SHR / F_PACKI
                            	    23: ;   $Cx  100 x move.l d1,(a0)+            an integer store, for reference
                            	    24: ;   $Dx  100 x fmove.d (a0)+,fp0          an FP load, for reference (the
                            	    25: ;                                         buffer refilled with doubles first)
                            	    26: ;   $Ex  100 x fadd.x fp1,fp0 ; fmove.d fp0,(a0)+   the matmul shape
                            	    27: ;   $Fx  100 x fmove.d fp0,(a0)+ ; fmove.d (a1)+,fp2   store then unrelated load
                            	    28: 
                            	    29: STAMP	equ	$F108
                            	    30: DONEREG	equ	$F102
                            	    31: BUF	equ	$20000
                            	    32: BUF2	equ	$24000
                            	    33: 
                            	    34: STMP	macro
                            	    35: 	move.w	#\1,d0
                            	    36: 	add.w	d5,d0
                            	    37: 	trap	#0
                            	    38: 	endm
                            	    39: 
                            	    40: 	org	0
00:00000000 0007F000        	    41: 	dc.l	$7F000		; SSP
00:00000004 00000400        	    42: 	dc.l	start
                            	    43: 	rept	254
                            	    44: 	dc.l	unexp
                            	    45: 	endr
