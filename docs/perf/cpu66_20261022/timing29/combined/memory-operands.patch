+  if(ex_is_fp && ex_u.cond==4'd0 &&
+     (ex_a[15:0] !== raw_ex_a_reference[15:0] || ex_b[15:0] !== raw_ex_b_reference[15:0]))
+   $fatal(1,"FAIL: FPU CHK raw instruction words changed");
+  ex_operand_checks<=ex_operand_checks+1;
+ end
+ if(nreset && adv_dc2) begin
+  raw_ex_a_reference <= (exw_v && dc2_u.a_src==OS_REG && dc2_u.a_reg==exw_reg)?exw_val:dc2_a;
+  raw_ex_b_reference <= (exw_v && dc2_u.b_src==OS_REG && dc2_u.b_reg==exw_reg)?exw_val:dc2_b;
+ end
