+// Memory selection occurs as DC2 enters EX, using the existing operand registers.
+wire [31:0] ex_av0 = ex_a;
@@ -644 +645 @@
-wire [31:0] ex_bv  = (ex_u.b_src == OS_MEM) ? ex_ld : ex_b;
+wire [31:0] ex_bv  = ex_b;
@@ -1853,2 +1854,4 @@
-			ex_a     <= (exw_v && dc2_u.a_src == OS_REG && dc2_u.a_reg == exw_reg) ? exw_val : dc2_a;
