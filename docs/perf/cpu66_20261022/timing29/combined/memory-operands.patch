@@ -2494,0 +2498,22 @@
+// synthesis translate_off
+logic [31:0] raw_ex_a_reference, raw_ex_b_reference;
+integer ex_operand_checks=0;
+always @(posedge clk) begin
+ if(nreset && ex_v) begin
+  if(ex_av0 !== ((ex_u.a_src==OS_MEM)?ex_ld:raw_ex_a_reference) ||
+     ex_bv !== ((ex_u.b_src==OS_MEM)?ex_ld:raw_ex_b_reference))
