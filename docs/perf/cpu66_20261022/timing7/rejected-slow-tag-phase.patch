+// The slow engine compares tags after translation, using its existing e_x
+// register. Fast DC1 lookup retains its parallel tag comparison below.
+function automatic xres_t cache_lookup(input xres_t translated,
+ input logic [21:0] t0, t1, t2, t3, input logic [3:0] valid);
+ xres_t x;
+ x = translated;
+ x.hit = 1'b0; x.way = 2'd0;
+ if (x.ok && !x.flt) begin
+  if (valid[0] && t0 == x.pa[31:10]) begin x.hit=1'b1; x.way=2'd0; end
+  if (valid[1] && t1 == x.pa[31:10]) begin x.hit=1'b1; x.way=2'd1; end
+  if (valid[2] && t2 == x.pa[31:10]) begin x.hit=1'b1; x.way=2'd2; end
+  if (valid[3] && t3 == x.pa[31:10]) begin x.hit=1'b1; x.way=2'd3; end
+ end
+ cache_lookup = x;
