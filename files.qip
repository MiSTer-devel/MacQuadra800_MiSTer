set_global_assignment -name SDC_FILE MacQuadra800.sdc
set_global_assignment -name SYSTEMVERILOG_FILE MacQuadra800.sv
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name VERILOG_FILE rtl/pll_video.v
# CPU_AP68040 branch: the pipelined AP68040 (rtl/ap68040_faster) behind
# rtl/quadra_cpu040.sv instead of the sequential ap040 tree + wombat_cpu
# (their FPU module names collide, so one CPU tree per build).
set_global_assignment -name QIP_FILE rtl/ap68040_faster/rtl/ap68040.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/quadra_cpu040.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wombat_bus32.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/quadra800.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/iosb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/via6522.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dafb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/rtc3430042.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/easc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ncr53c96.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cd_audio.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sonic_mbx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/scsi_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adb.sv
set_global_assignment -name VERILOG_FILE rtl/scc.v
set_global_assignment -name VERILOG_FILE rtl/uart/txuart.v
set_global_assignment -name VERILOG_FILE rtl/uart/rxuart.v
set_global_assignment -name VERILOG_FILE rtl/dpram.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram_beat32.sv
