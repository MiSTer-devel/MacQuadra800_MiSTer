# AP68040 (rtl/ap68040, the pipelined core): Quartus file list in dependency
# order, as syn/fitcore.sh lists it.  The generated rtl/gen/*.svh tables are
# `included, not compiled, hence the search paths.
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) "."]
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) "gen"]
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) "fpu"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_pkg.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "gen/ap68040_upkg.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_alu.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_alu_slow.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_muldiv.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_biu.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_ram.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_atc.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_dmu.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_predec.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_fetch.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_decode.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_useq.sv"]
set_global_assignment -name VERILOG_FILE       [file join $::quartus(qip_path) "fpu/ap040_fpu.v"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_fpif.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_backend.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040_snoop.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "ap68040.sv"]
